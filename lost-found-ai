}const express = require("express");
const path = require("path");
const { Firestore } = require("@google-cloud/firestore");
const { GoogleGenAI } = require("@google/genai");

const app = express();
const PORT = process.env.PORT || 8080;

app.use(express.json());
app.use(express.static(path.join(__dirname, "public")));

const firestore = new Firestore();

const ai = new GoogleGenAI({
  apiKey: process.env.GEMINI_API_KEY
});

app.post("/api/match", async (req, res) => {
  try {
    const { type, itemName, description, location, date } = req.body;

    if (!type || !itemName || !description) {
      return res.status(400).json({
        error: "Please provide item type, name and description."
      });
    }

    const prompt = `
You are an AI Lost and Found matching assistant.

Analyze this ${type} item:

Item name: ${itemName}
Description: ${description}
Location: ${location || "Not provided"}
Date: ${date || "Not provided"}

Return JSON only in this format:
{
  "matchScore": number from 0 to 100,
  "category": "category",
  "summary": "short explanation",
  "suggestion": "what the user should do next"
}

Do not use markdown.
`;

    const response = await ai.models.generateContent({
      model: "gemini-2.5-flash",
      contents: prompt
    });

    const text = response.text
      .replace(/```json/g, "")
      .replace(/```/g, "")
      .trim();

    const result = JSON.parse(text);

    const record = {
      type,
      itemName,
      description,
      location: location || "",
      date: date || "",
      result,
      createdAt: new Date()
    };

    await firestore.collection("lost_found_items").add(record);

    res.json(result);
  } catch (error) {
    console.error(error);

    res.status(500).json({
      error: "Something went wrong while analyzing the item."
    });
  }
});

app.get("*", (req, res) => {
  res.sendFile(path.join(__dirname, "public", "index.html"));
});

app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
